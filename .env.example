# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user IDs with admin access (get yours from @userinfobot)
ADMIN_IDS=

SHOP_NAME=Digital Shop
# Shown on the "Support" button, e.g. @your_support
SUPPORT_CONTACT=

# ── Database ──────────────────────────────────────────────────────────────
# Leave empty for SQLite at ./data/shop.db. For PostgreSQL (pip install asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shop
DATABASE_URL=

# ── Cube Tech Commerce API (separate PostgreSQL database) ──────────────────
# The API uses a restricted runtime role; run Alembic with MIGRATION_DATABASE_URL.
COMMERCE_DATABASE_URL=postgresql+asyncpg://commerce_runtime:runtime_dev_only@localhost:5432/commerce
MIGRATION_DATABASE_URL=postgresql+asyncpg://commerce_migrator:migrator_dev_only@localhost:5432/commerce
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_at_least_32_chars
DIGITAL_ASSET_ENCRYPTION_KEY=
APP_ENV=development
POSTGRES_PASSWORD=migrator_dev_only
COMMERCE_RUNTIME_PASSWORD=runtime_dev_only

# ── Crypto payments: Crypto Pay (@CryptoBot) ─────────────────────────────
# Mainnet: open @CryptoBot → Crypto Pay → Create App → copy the API token.
# Testnet: same in @CryptoTestnetBot (free test coins) and set CRYPTOPAY_TESTNET=true.
# Leave the token empty to disable top-ups (admins can still add balance by hand).
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=true
# Coins customers may pay with
CRYPTOPAY_ASSETS=USDT,TON,BTC,ETH,LTC,TRX,BNB,USDC

# Currency for prices and balances (USD, EUR, GBP, …)
CURRENCY=USD
MIN_DEPOSIT=1
MAX_DEPOSIT=10000
# Quick-pick amounts on the top-up screen
DEPOSIT_PRESETS=5,10,25,50,100
INVOICE_TTL_MINUTES=60
# Unpaid invoices a user may have open at once
MAX_PENDING_DEPOSITS=3
# How often (seconds) to poll Crypto Pay for paid invoices
PAYMENT_POLL_INTERVAL=15

# ── Shop behaviour ────────────────────────────────────────────────────────
# Admins are alerted once a product's stock drops to this level
LOW_STOCK_THRESHOLD=5
MAX_QTY_PER_ORDER=50
# Notify admins about every order and top-up
NOTIFY_ADMINS=true
LOG_LEVEL=INFO
